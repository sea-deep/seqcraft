# Browser-facing origin. Keep API and web app on the same public origin in production.
APP_ORIGIN=http://localhost:5173
PORT=8787
NODE_ENV=development

# Atlas metadata database. Raw or derived biological sequences must never be stored here.
MONGODB_URI=
MONGODB_DB=seqcraft

# Generate at least 32 high-entropy characters. Leave blank to run in guest/local mode.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Optional Google OAuth. Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
